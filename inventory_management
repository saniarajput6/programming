import tkinter as tk
from tkinter import ttk, messagebox

root = tk.Tk()
root.title("Inventory Management")
root.geometry("650x450")

products = []

title = tk.Label(root, text="Inventory Management",
                 font=("Arial", 18, "bold"))
title.pack(pady=10)

# Product input fields
input_frame = tk.Frame(root)
input_frame.pack(pady=10)

tk.Label(input_frame, text="Product Name").grid(row=0, column=0)
tk.Label(input_frame, text="Quantity").grid(row=0, column=1)
tk.Label(input_frame, text="Price").grid(row=0, column=2)

name_entry = tk.Entry(input_frame, width=18)
quantity_entry = tk.Entry(input_frame, width=12)
price_entry = tk.Entry(input_frame, width=12)

name_entry.grid(row=1, column=0, padx=5)
quantity_entry.grid(row=1, column=1, padx=5)
price_entry.grid(row=1, column=2, padx=5)

# Product table
columns = ("Name", "Quantity", "Price", "Total")

table = ttk.Treeview(root, columns=columns, show="headings")

for column in columns:
    table.heading(column, text=column)
    table.column(column, width=130)

table.pack(pady=15, padx=10, fill="both", expand=True)


def add_product():
    name = name_entry.get()
    quantity = quantity_entry.get()
    price = price_entry.get()

    if not name or not quantity or not price:
        messagebox.showwarning("Missing Details", "Fill in all fields.")
        return

    try:
        quantity = int(quantity)
        price = float(price)

        if quantity <= 0 or price < 0:
            raise ValueError

    except ValueError:
        messagebox.showerror(
            "Invalid Input", "Enter a positive quantity and valid price."
        )
        return

    total = quantity * price

    products.append([name, quantity, price])

    table.insert("", "end", values=(
        name, quantity, f"{price:.2f}", f"{total:.2f}"
    ))

    name_entry.delete(0, tk.END)
    quantity_entry.delete(0, tk.END)
    price_entry.delete(0, tk.END)


def delete_product():
    selected = table.selection()

    if not selected:
        messagebox.showwarning("No Selection", "Select a product first.")
        return

    for item in selected:
        table.delete(item)


def show_total():
    total = sum(item[1] * item[2] for item in products)

    messagebox.showinfo(
        "Inventory Value", f"Total inventory value: {total:.2f}"
    )


# Buttons
button_frame = tk.Frame(root)
button_frame.pack(pady=10)

tk.Button(button_frame, text="Add Product",
          command=add_product).grid(row=0, column=0, padx=5)

tk.Button(button_frame, text="Delete Product",
          command=delete_product).grid(row=0, column=1, padx=5)

tk.Button(button_frame, text="Show Total Value",
          command=show_total).grid(row=0, column=2, padx=5)

root.mainloop()