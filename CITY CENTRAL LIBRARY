# clear and select book

def clear_boxes():
    title_entry.delete(0, tk.END)
    author_entry.delete(0, tk.END)
    isbn_entry.delete(0, tk.END)
    quantity_entry.delete(0, tk.END)

def get_selected_isbn():
    selected = book_table.selection()

    if selected:
        return selected[0]

    messagebox.showwarning("Select a Book", "Please select a book first.")
    return None

def fill_boxes(event):
    isbn = get_selected_isbn()

    if isbn:
        book = books[isbn]

        clear_boxes()
        title_entry.insert(0, book["title"])
        author_entry.insert(0, book["author"])
        isbn_entry.insert(0, isbn)
        quantity_entry.insert(0, book["quantity"])

# add book

def add_book():
    title = title_entry.get().strip()
    author = author_entry.get().strip()
    isbn = isbn_entry.get().strip()
    quantity = quantity_entry.get().strip()

    if not title or not author or not isbn or not quantity:
        messagebox.showerror("Error", "Please complete all the fields.")
        return

    if not isbn.isdigit() or len(isbn) != 10:
        messagebox.showerror("Error", "ISBN must contain exactly 10 digits.")
        return

    if isbn in books:
        messagebox.showerror("Error", "This ISBN already exists.")
        return

    if not quantity.isdigit():
        messagebox.showerror("Error", "Copies must be a whole number.")
        return

    books[isbn] = {
        "title": title,
        "author": author,
        "quantity": int(quantity),
        "borrowed": 0
    }

    if save_books():
        clear_boxes()
        refresh_books()
        messagebox.showinfo("Success", "Book added successfully.")
    else:
        del books[isbn]

# EDIT A BOOK

def edit_book():
    isbn = get_selected_isbn()

    if isbn is None:
        return

    title = title_entry.get().strip()
    author = author_entry.get().strip()

    if not title or not author:
        messagebox.showerror("Error", "Title and author cannot be empty.")
        return

    old_title = books[isbn]["title"]
    old_author = books[isbn]["author"]

    books[isbn]["title"] = title
    books[isbn]["author"] = author

    if save_books():
        refresh_books()
        messagebox.showinfo("Success", "Book updated successfully.")
    else:
        books[isbn]["title"] = old_title
        books[isbn]["author"] = old_author

# delete book

def delete_book():
    isbn = get_selected_isbn()

    if isbn is None:
        return

    book = books[isbn]

    if book["borrowed"] > 0:
        messagebox.showwarning("Error", "Return borrowed copies before deleting.")
        return

    answer = messagebox.askyesno(
        "Delete Book", f'Are you sure you want to delete "{book["title"]}"?'
    )

    if answer:
        removed_book = books.pop(isbn)

        if save_books():
            clear_boxes()
            refresh_books()
            messagebox.showinfo("Success", "Book deleted successfully.")
        else:
            books[isbn] = removed_book
            refresh_books()

# borrow book

def borrow_book():
    isbn = get_selected_isbn()

    if isbn is None:
        return

    book = books[isbn]

    if book["quantity"] <= 0:
        messagebox.showwarning("Unavailable", "No copies are available.")
        return

    copies = simpledialog.askinteger(
        "Borrow Book", "How many copies do you want to borrow?", parent=root
    )

    if copies is None:
        return

    if copies <= 0:
        messagebox.showerror("Error", "Enter at least 1 copy.")
        return

    if copies > book["quantity"]:
        messagebox.showerror("Error", "Not enough copies available.")
        return

    book["quantity"] -= copies
    book["borrowed"] += copies

    if save_books():
        refresh_books()
        messagebox.showinfo("Success", "Book borrowed successfully.")
    else:
        book["quantity"] += copies
        book["borrowed"] -= copies
        refresh_books()

# return book

def return_book():
    isbn = get_selected_isbn()

    if isbn is None:
        return

    book = books[isbn]

    if book["borrowed"] <= 0:
        messagebox.showwarning("Return Book", "No borrowed copies recorded.")
        return

    copies = simpledialog.askinteger(
        "Return Book", "How many copies do you want to return?", parent=root
    )

    if copies is None:
        return

    if copies <= 0:
        messagebox.showerror("Error", "Enter at least 1 copy.")
        return

    if copies > book["borrowed"]:
        messagebox.showerror("Error", "Too many copies entered.")
        return

    book["quantity"] += copies
    book["borrowed"] -= copies

    if save_books():
        refresh_books()
        messagebox.showinfo("Success", "Book returned successfully.")
    else:
        book["quantity"] -= copies
        book["borrowed"] += copies
        refresh_books()

# low stock

def low_stock():
    low_books = []

    for isbn, book in books.items():
        if book["quantity"] < 3:
            low_books.append((book["title"], isbn, book["quantity"]))

    if not low_books:
        messagebox.showinfo("Low Stock", "There are no low-stock books.")
        return

    low_window = tk.Toplevel(root)
    low_window.title("Low-Stock Books")
    low_window.geometry("560x320")
    low_window.configure(bg=BACKGROUND)

    ttk.Label(low_window, text="LOW-STOCK BOOKS",
              font=("Arial", 14, "bold")).pack(pady=12)

    low_table = ttk.Treeview(
        low_window, columns=("title", "isbn", "quantity"), show="headings"
    )

    low_table.heading("title", text="Book Title")
    low_table.heading("isbn", text="ISBN")
    low_table.heading("quantity", text="Available")

    low_table.column("title", width=250)
    low_table.column("isbn", width=150)
    low_table.column("quantity", width=80, anchor="center")

    low_table.pack(fill="both", expand=True, padx=10, pady=10)

    for book in low_books:
        low_table.insert("", "end", values=book)

